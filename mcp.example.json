{
  "mcpServers": {
    "nats-demo": {
      "command": "<PROJE>/target/release/local-proxy.exe",
      "args": [],
      "env": {
        "NATS_URL": "nats://localhost:4222",
        "MCP_SUBJECT": "mcp.demo"
